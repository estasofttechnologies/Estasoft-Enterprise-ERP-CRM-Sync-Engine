{
  "name": "estasofttechnologies/estasoft-erp-crm-sync-engine",
  "description": "Estasoft Enterprise ERP/CRM Sync Engine: a WooCommerce plugin that keeps your store in step with your ERP, accounting system or CRM through a durable queue.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "homepage": "https://github.com/estasofttechnologies/estasoft-enterprise-erp-crm-sync-engine",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.6",
    "yoast/phpunit-polyfills": "^2.0",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "phpstan/phpstan": "^1.12",
    "szepeviktor/phpstan-wordpress": "^1.3",
    "php-stubs/woocommerce-stubs": "^9.4",
    "phpstan/extension-installer": "^1.4"
  },
  "autoload": {
    "psr-4": { "Estasoft\\SyncEngine\\": "includes/" }
  },
  "autoload-dev": {
    "psr-4": { "Estasoft\\SyncEngine\\Tests\\": "tests/php/" }
  },
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "phpstan/extension-installer": true
    }
  },
  "scripts": {
    "lint": "phpcs",
    "lint:fix": "phpcbf",
    "analyse": "phpstan analyse --memory-limit=1G",
    "test": "phpunit",
    "test:integration": "phpunit -c phpunit-integration.xml.dist",
    "check": ["@lint", "@analyse", "@test"]
  }
}
