# The WordPress extension (szepeviktor/phpstan-wordpress) is registered by phpstan/extension-installer; do not include it here.
parameters:
  level: 6
  paths:
    - includes
    - estasoft-erp-crm-sync-engine.php
  scanFiles:
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    - tests/phpstan-stubs.php
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  treatPhpDocTypesAsCertain: false
  tmpDir: .phpstan-cache
