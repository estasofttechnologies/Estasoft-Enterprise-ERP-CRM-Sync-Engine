# The WordPress extension (szepeviktor/phpstan-wordpress) is registered by phpstan/extension-installer; do not include it here.
parameters:
  level: 6
  paths:
    - includes
    - estasoft-enterprise-erpcrm-sync-engine.php
  scanFiles:
    - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
    - tests/phpstan-stubs.php
  bootstrapFiles:
    - tests/phpstan-bootstrap.php
  treatPhpDocTypesAsCertain: false
  tmpDir: .phpstan-cache
  # Two worker processes of up to 2 GB each fit on a standard GitHub runner; more can run it out of memory.
  parallel:
    maximumNumberOfProcesses: 2
