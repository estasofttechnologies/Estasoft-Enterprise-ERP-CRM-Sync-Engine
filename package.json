{
  "name": "estasoft-erp-crm-sync-engine",
  "version": "0.1.0",
  "description": "Admin app for the Estasoft Enterprise ERP/CRM Sync Engine WordPress plugin.",
  "license": "GPL-2.0-or-later",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/estasofttechnologies/estasoft-enterprise-erp-crm-sync-engine.git"
  },
  "scripts": {
    "build": "wp-scripts build --webpack-src-dir=src --output-path=build",
    "start": "wp-scripts start --webpack-src-dir=src --output-path=build",
    "build:mock": "cross-env ESTASOFT_MOCK=1 wp-scripts build --webpack-src-dir=src --output-path=build/mock",
    "start:mock": "cross-env ESTASOFT_MOCK=1 wp-scripts start --webpack-src-dir=src --output-path=build/mock",
    "lint:js": "wp-scripts lint-js src tests/js",
    "lint:css": "wp-scripts lint-style \"src/**/*.scss\"",
    "typecheck": "tsc --noEmit",
    "test:js": "wp-scripts test-unit-jest --config jest.config.js",
    "format": "wp-scripts format src tests/js",
    "check:js": "npm run typecheck && npm run lint:js && npm run lint:css && npm run test:js && npm run build"
  },
  "dependencies": {
    "@wordpress/a11y": "^5.0.0",
    "@wordpress/api-fetch": "^8.0.0",
    "@wordpress/components": "^43.0.0",
    "@wordpress/element": "^10.0.0",
    "@wordpress/i18n": "^7.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@wordpress/scripts": "^37.0.0",
    "babel-jest": "^30.5.2",
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jest-environment-jsdom": "^30.5.2",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=20.10",
    "npm": ">=10"
  }
}
